# Debug symbols are stored as brotli (<name>.wasm.br, see _redirects) and requested as
# <name>.wasm. Pages matches this rule against the requested URL, not the stored file.
# Clients that accept br get the compressed bytes; others get them decoded.
/symbols/*.wasm
  Content-Type: application/wasm
  Content-Encoding: br
  Cache-Control: public, max-age=31536000, immutable, no-transform
